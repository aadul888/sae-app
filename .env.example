# SAE App Configuration
# This is an EXAMPLE file showing the structure of .env
# 
# INSTRUCTIONS:
# 1. Fresh install: Access /installer.php to create .env automatically
# 2. Manual setup: Copy this to .env and fill in your database credentials
# 3. DO NOT commit .env to git — it contains sensitive credentials
# 
# To reconfigure after initial setup:
# 1. Delete the existing .env file
# 2. Access /installer.php again
# 3. Follow the setup wizard

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sae_db
DB_USER=root
DB_PASSWD=
