# Allow images only

<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
<IfModule mod_authz_core.c>
Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Allow from all
</IfModule>
</FilesMatch>

# Block PHP and other executable files

<FilesMatch "\.(php|php[0-9]|phtml|pht|phar|shtml|cgi|pl|py|rb|sh|asp|aspx|htaccess|htpasswd)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order deny,allow
Deny from all
</IfModule>
</FilesMatch>
